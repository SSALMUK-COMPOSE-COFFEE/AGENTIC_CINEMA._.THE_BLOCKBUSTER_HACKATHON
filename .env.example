GEMINI_API_KEY=                     # Google AI Studio key
GEMINI_BASE_URL=                    # leave empty for https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=shotmem
CLICKHOUSE_PASSWORD=shotmem
CLICKHOUSE_DATABASE=shot_memory
CLICKHOUSE_SECURE=false
MCP_CLICKHOUSE_COMMAND=mcp-clickhouse   # installed with: uv tool install mcp-clickhouse

DATA_DIR=./data
INGEST_CONCURRENCY=8
